# Sledovane URL (vcetne email_to prijemcu) se nastavuji v data/urls.json, ne tady.
# Soubor musi existovat, jinak scraper skonci chybou - viz README.

# Cesta k souboru se seznamem sledovanych URL
URLS_FILE=./data/urls.json

# Adresar pro lokalni JSON databaze - kazda URL ma svuj soubor <hash>.json podle hashe URL
DB_DIR=./data/db

# Jak casto se ma scraper spoustet, kdyz bezi jako demon (node-cron syntax)
# Priklad: kazdych 15 minut
CRON_SCHEDULE=*/15 * * * *

# Prodleva mezi jednotlivymi requesty (detail inzeratu, dalsi strana vypisu, dalsi sledovana URL), v ms
REQUEST_DELAY_MS=1500

# Kolik stranek vypisu se maximalne prochazi na jednu URL (pojistka proti nekonecne smycce)
MAX_PAGES=80

# Pocet inzeratu na stranku vypisu (bazos pouziva 20)
PAGE_SIZE=20

# --- SMTP (napr. Gmail) ---
# Pro Gmail je potreba vytvorit "App Password" (Google ucet -> Zabezpeceni -> Dvoufazove overeni -> Hesla aplikaci)
# Bezne heslo k uctu SMTP auth u Gmailu nepovoli.
# Prijemci se nenastavuji tady, ale u kazde URL zvlast v data/urls.json (pole "email_to").
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tvuj.email@gmail.com
SMTP_PASS=aplikacni-heslo
SMTP_FROM=tvuj.email@gmail.com
